# ── Kalshi API credentials ───────────────────────────────────────────────────
# Get from https://kalshi.com/account/api
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_KEY_ID=                    # your API key ID (UUID format)
KALSHI_PRIVKEY_PATH=kalshi_private_key.pem  # RSA private key for WebSocket auth

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kalshi_arb
DB_USER=postgres
DB_PASSWORD=                      # your PostgreSQL password

# ── External data sources (optional — Phase 9 cross-asset analysis) ──────────
FRED_API_KEY=                     # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=                      # https://www.eia.gov/opendata/
ALPHA_VANTAGE_API_KEY=            # https://www.alphavantage.co/support/#api-key

# ── Synthesis API (live Kalshi orderbook — no Kalshi account needed) ─────────
SYNTHESIS_PUBLIC_KEY=pk_...          # from https://app.synthfinance.com/api-keys
SYNTHESIS_SECRET_KEY=sk_gs-...       # never commit the real value

# ── Application settings ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
SCAN_INTERVAL_SECONDS=60
MAX_OPPORTUNITIES_PER_RUN=10000
